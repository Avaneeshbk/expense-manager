TELEGRAM_BOT_TOKEN=8901059698:AAHaiOdRwxcwtV-P2skAsjzCbmxXRTNPimY

# --- Google Gemini (free tier: aistudio.google.com) ---
GEMINI_API_KEY=AQ.Ab8RN6IYQpFW0D1iJma4IIrY9cGkwuPvkPCS0YOsMJ7GFakR9w
# Use gemini-2.5-flash-lite for higher free-tier quota.
# gemini-2.5-flash is also available but can be rate-limited to 20 req/day.
GEMINI_MODEL=gemini-2.5-flash-lite

# Separate model for image OCR (receipts). Use the -latest alias which
# has more generous free-tier image quotas than pinned versions.
OCR_MODEL=gemini-flash-lite-latest

# --- Supabase (free tier: supabase.com) ---
# Find these in Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# SUPABASE_ANON_KEY=YOUR_ANON_KEY     # only if dashboard needs it (client-side)

# --- Reminders ---
DEFAULT_REMINDER_HOUR=21   # 9 PM (24h, IST)
DEFAULT_REMINDER_MIN=0
TIMEZONE=Asia/Kolkata

# --- Owner (you) — used for fallback /admin commands ---
OWNER_TELEGRAM_ID=6889231365

# --- Optional: Groq Whisper fallback for low-quality STT ---
# Leave empty to use only Telegram's built-in transcription.
GROQ_API_KEY=
