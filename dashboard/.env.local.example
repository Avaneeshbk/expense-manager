# Local dev: copy this file to .env.local and fill in the values
# (these stay on your machine, never committed)

# Your Supabase project URL
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Service role key — used ONLY by the Vercel serverless functions in /api
# The browser never sees this key.
# Get it from: Supabase dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Your Telegram user ID (get it from @userinfobot on Telegram)
# This tells the dashboard which user's data to fetch.
DASHBOARD_TELEGRAM_ID=6889231365
